{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.production*)",
      "Read(/evidencia/**)",
      "Edit(/evidencia/**)",
      "Read(/**/*.pdf)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add .env*)",
      "Bash(git add evidencia*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel*env pull*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm *-r*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git add -f*)",
      "PowerShell(git add --force*)",
      "PowerShell(git add .env*)",
      "PowerShell(git add evidencia*)",
      "PowerShell(vercel env pull*)",
      "PowerShell(npx vercel*env pull*)"
    ],
    "ask": [
      "Bash(vercel deploy*)",
      "Bash(npx vercel*deploy*)",
      "Bash(npm run import:legacy*)",
      "Bash(npm run db:seed*)",
      "PowerShell(vercel deploy*)",
      "PowerShell(npx vercel*deploy*)",
      "PowerShell(npm run import:legacy*)",
      "PowerShell(npm run db:seed*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.+__(execute_sql|apply_migration))$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-sql-destructivo.mjs"]
          }
        ]
      }
    ]
  }
}
