# Copia este fichero a .env.local y rellena. .env.local NO se sube a git.

# ── Base de datos ──────────────────────────────────────────────
# Vacío = Postgres local embebido (PGlite) en .data/pglite. Para producción:
# cadena del pooler de Supabase (Project Settings → Database → Connection string → Transaction pooler).
DATABASE_URL=

# ── Sesión del dueño ───────────────────────────────────────────
# AUTH_MODE=dev entra sin contraseña con un atleta local. Solo se respeta si DATABASE_URL está vacío.
AUTH_MODE=dev
OWNER_EMAIL=
# Genera el hash con:  npm run hash-password
OWNER_PASSWORD_HASH=
# 32 bytes aleatorios:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── URL pública (emisor OAuth del servidor MCP) ────────────────
APP_URL=http://localhost:3000

# ── Open Food Facts (lector de códigos de barras) ──────────────
# Piden un User-Agent con contacto. No hace falta clave.
OFF_USER_AGENT=sistema-fisico/0.1 (pon-aqui-un-contacto)

# ── Google Drive (vídeos y fotos de progreso) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

# ── Importar las 102 sesiones de la app antigua (una sola vez) ─
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_KEY=
LEGACY_USER_ID=
